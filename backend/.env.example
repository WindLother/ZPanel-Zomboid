# ---------------------------------------------------------------------------
# ZPanel backend configuration. Copy to `.env` and fill in. NEVER commit `.env`.
# Placeholders only — put real secrets exclusively in the deployed .env (0600).
# ---------------------------------------------------------------------------

NODE_ENV=production

# The backend binds locally; a reverse proxy (Caddy/Nginx) terminates TLS.
HOST=127.0.0.1
PORT=8095

# Comma-separated list of allowed browser origins (the panel URL). Used for CORS
# and CSRF origin checks. Example: https://panel.example.com
PANEL_ORIGINS=https://panel.example.com

# Set true only when serving the panel behind HTTPS (enables Secure cookies).
COOKIE_SECURE=true

# 32+ byte random string used to sign session cookies. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=<strong-secret>

# --- Server runtime adapter -------------------------------------------------
# 'systemd'    -> RECOMMENDED standalone deployment: the panel controls one
#                 fixed systemd unit (SYSTEMD_UNIT); metrics via /proc.
# 'amp'        -> CubeCoders AMP owns lifecycle + metrics + updates.
# 'standalone' -> run WITHOUT lifecycle management: metrics via /proc only
#                 (use when PZ is started by docker/a script/by hand).
PZ_RUNTIME=systemd

# Fixed systemd unit the panel controls when PZ_RUNTIME=systemd. Server-side
# config only — never derived from a request. Pair with a scoped sudoers rule
# allowing exactly `systemctl start|stop|restart <this unit>` for the panel user.
SYSTEMD_UNIT=project-zomboid-zpanel.service

# --- Project Zomboid files --------------------------------------------------
# The config-set name: <name>.ini, <name>_SandboxVars.lua, db/<name>.db
PZ_SERVER_NAME=servertest
# Directory containing <name>.ini / <name>_SandboxVars.lua
PZ_SERVER_DIR=/srv/project-zomboid/data/Zomboid/Server
# Zomboid data root (parent of Server/, Logs/, db/). Derived from PZ_SERVER_DIR if unset.
PZ_ZOMBOID_DIR=/srv/project-zomboid/data/Zomboid
# Steam Workshop content dir (.../steamapps/workshop/content/108600). Set this
# when the server install is separate from the Zomboid data root.
PZ_WORKSHOP_DIR=/srv/project-zomboid/server/steamapps/workshop/content/108600
# PZ server install dir (holds ProjectZomboid64.json + steamapps/). Used to read
# the configured JVM heap shown on the dashboard. Derived from PZ_WORKSHOP_DIR
# (or the Zomboid data root's parent) when unset.
#PZ_INSTALL_DIR=/srv/project-zomboid/server

# --- RCON (native Project Zomboid remote console, LOCALHOST ONLY) ------------
# Must match RCONPort / RCONPassword in <name>.ini. Never expose RCON publicly.
PZ_RCON_HOST=127.0.0.1
PZ_RCON_PORT=27015
PZ_RCON_PASSWORD=<strong-secret>

# --- AMP (CubeCoders) — only used when PZ_RUNTIME=amp ------------------------
# Instance webserver + credentials for an AMP user with rights on this instance.
# If AMP_BASE_URL/credentials are omitted, lifecycle falls back to `ampinstmgr`.
#AMP_BASE_URL=http://127.0.0.1:8083
#AMP_USERNAME=
#AMP_PASSWORD=<strong-secret>
#AMP_INSTANCE_NAME=MyInstance01
#AMP_INSTANCE_ID=
# `ampinstmgr` fallback: the system user that owns AMP (commands run via sudo -u).
#AMP_SYSTEM_USER=amp
# Set false to disable the ampinstmgr fallback entirely (AMP HTTP API only).
#AMP_ALLOW_CLI=true

# --- Panel application database ----------------------------------------------
# Use an absolute panel-owned path in production, e.g. /var/lib/zpanel/panel.db
PANEL_DB_PATH=./data/panel.db

# Bounded in-memory resource history (samples kept for the dashboard chart).
METRICS_SAMPLE_MS=5000
METRICS_HISTORY_POINTS=120

# Optional: serve the static frontend from the backend itself (single-host
# setups without a reverse proxy serving statics). Usually the proxy does this.
#FRONTEND_DIR=/srv/zpanel/public

# --- Steam Workshop version lookup -------------------------------------------
# Optional. When true (default) the "Check for updates" action asks Steam's
# public, key-less GetPublishedFileDetails endpoint for each Workshop item's
# published version, and compares it with what is installed on disk. This is
# what lets the panel name WHICH mods are out of date -- Project Zomboid's own
# checkModsNeedUpdate only reports a yes/no verdict for the whole collection.
# Only public Workshop IDs from your own server config are sent. Set false for
# a fully offline panel; the check then falls back to the game server's report.
STEAM_WORKSHOP_API=true
